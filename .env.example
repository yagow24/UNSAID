# ==================================================
# UNSAID FRONTEND ENVIRONMENT VARIABLES (Vite)
# ==================================================
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Application Base URL (Optional - for shareable invite links across devices)
# - Leave empty during local development to use window.location.origin dynamically
# - In production / public network: set to domain (e.g., https://your-unsaid-domain.com)
VITE_APP_BASE_URL=

# ==================================================
# BACKEND ENVIRONMENT VARIABLES (Flask & Gemini AI)
# Note: NEVER prefix backend secrets with VITE_ to prevent bundling into client builds.
# The GEMINI_API_KEY is backend-only and must NEVER be placed in client/browser code.
# ==================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=5001
FIREBASE_PROJECT_ID=
# FIREBASE_KEY_PATH=./serviceAccountKey.json
